{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "A service booking request from a customer",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "description": "Full name of the customer" },
        "customerEmail": { "type": "string", "format": "email", "description": "Email address of the customer" },
        "customerPhone": { "type": "string", "description": "Phone number of the customer" },
        "serviceId": { "type": "string", "description": "ID of the selected service" },
        "serviceName": { "type": "string", "description": "Name of the selected service" },
        "date": { "type": "string", "description": "Date of the appointment" },
        "time": { "type": "string", "description": "Time window for the appointment" },
        "notes": { "type": "string", "description": "Additional notes from the customer" },
        "totalPrice": { "type": "number", "description": "Price of the service at the time of booking" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"], "description": "Current status of the booking" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the booking was created" }
      },
      "required": ["customerName", "customerEmail", "customerPhone", "serviceId", "date", "time", "status"]
    }
  },
  "firestore": {
    "bookings/{bookingId}": {
      "schema": "booking",
      "description": "Collection of all service bookings"
    }
  }
}
